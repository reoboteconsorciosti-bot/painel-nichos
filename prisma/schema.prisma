generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        Int      @id @default(autoincrement())
  name      String?
  phone     String?  @unique
  nicho     String?
  city      String?
  state     String?
  company   String?
  fantasy   String?
  email     String?
  jobTitle  String?  @map("job_title")
  dealDescription String? @map("deal_description")
  crmDealId String? @map("crm_deal_id")
  createdAt DateTime @default(now()) @map("created_at")

  listaLeads ListaLead[]
  blackFridayClaim BlackFridayLead?
  crmDeliveries CrmDelivery[]

  @@map("leads")
  @@index([city], map: "idx_leads_city")
  @@index([nicho], map: "idx_leads_nicho")
  @@index([nicho, state, city], map: "idx_leads_nicho_state_city")
}

model CrmDelivery {
  id Int @id @default(autoincrement())
  leadId Int? @map("lead_id")
  listaId Int? @map("lista_id")
  consultantCrmId String @map("consultant_crm_id")
  payload Json
  method String
  status String @default("pending")
  crmDealId String? @map("crm_deal_id")
  error String?
  warnings Json?
  attemptedAt DateTime? @map("attempted_at")
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  idempotencyKey String @unique @map("idempotency_key")
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Restrict)
  lista Lista? @relation(fields: [listaId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt], map: "idx_crm_deliveries_pending")
  @@index([listaId], map: "idx_crm_deliveries_lista")
  @@map("crm_deliveries")
}

model ImportLog {
  id         Int      @id @default(autoincrement())
  fileName   String   @map("file_name")
  totalRows  Int      @map("total_rows")
  validRows  Int      @map("valid_rows")
  invalidRows Int     @map("invalid_rows")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("import_logs")
}

model ImportBatch {
  id             Int      @id @default(autoincrement())
  fileName       String   @map("file_name")
  niche          String
  importedCount  Int      @default(0) @map("imported_count")
  existingCount  Int      @default(0) @map("existing_count")
  leadIds        Json     @default("[]") @map("lead_ids")
  fingerprint    String   @unique
  removedCount   Int      @default(0) @map("removed_count")
  status         String   @default("completed")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  undoneAt       DateTime? @map("undone_at")

  @@map("import_batches")
  @@index([createdAt])
}

model Lista {
  id          Int      @id @default(autoincrement())
  consultorId Int      @map("consultor_id")
  crmConsultantId String? @map("crm_consultant_id")
  nicho       String
  quantidade  Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  
  agendorStatus String    @default("none") @map("agendor_status")
  agendorSentAt DateTime? @map("agendor_sent_at")

  leads ListaLead[]
  crmDeliveries CrmDelivery[]

  @@map("listas")
  @@index([consultorId], map: "idx_listas_consultor_id")
  @@index([crmConsultantId, createdAt], map: "idx_listas_crm_consultant_created_at")
  @@index([nicho], map: "idx_listas_nicho")
}

model ConsultantQuota {
  crmUserId    String   @id @map("crm_user_id")
  monthlyLimit Int      @default(300) @map("monthly_limit")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("consultant_quotas")
}

model ConsultantMonthlyUsage {
  id         Int      @id @default(autoincrement())
  crmUserId  String   @map("crm_user_id")
  monthStart DateTime @map("month_start") @db.Date
  used       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([crmUserId, monthStart], map: "uq_consultant_monthly_usage_user_month")
  @@index([monthStart], map: "idx_consultant_monthly_usage_month")
  @@map("consultant_monthly_usage")
}

model ListaLead {
  id      Int   @id @default(autoincrement())
  listaId Int   @map("lista_id")
  leadId  Int   @map("lead_id")

  lista Lista @relation(fields: [listaId], references: [id], onDelete: Cascade)
  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lista_leads")
  @@unique([listaId, leadId], map: "uq_lista_leads_lista_id_lead_id")
  @@index([leadId], map: "idx_lista_leads_lead_id")
  @@index([listaId], map: "idx_lista_leads_lista_id")
}

model Consultant {
  id           String   @id @default(uuid())
  crmMemberId  String?  @unique(map: "uq_consultants_crm_member_id") @map("crm_member_id")
  name         String
  supervisorId String   @map("supervisor_id")
  createdAt    DateTime @default(now()) @map("created_at")
  blackFridayLeads BlackFridayLead[]

  @@map("consultants")
  @@index([supervisorId], map: "idx_consultants_supervisor_id")
}

model BlackFridayCampaign {
  id        Int              @id @default(autoincrement())
  year      Int              @unique
  name      String
  nicho     String           @unique
  isActive  Boolean          @default(true) @map("is_active")
  startsAt  DateTime         @map("starts_at") @db.Date
  endsAt    DateTime         @map("ends_at") @db.Date
  createdAt DateTime         @default(now()) @map("created_at")
  leads     BlackFridayLead[]

  @@map("black_friday_campaigns")
}

model BlackFridayLead {
  id           Int               @id @default(autoincrement())
  campaignId   Int               @map("campaign_id")
  leadId       Int               @unique @map("lead_id")
  supervisorId String            @map("supervisor_id")
  consultantId String?           @map("consultant_id")
  consultantName String          @map("consultant_name")
  assignedAt   DateTime          @default(now()) @map("assigned_at")
  crmStatus    String            @default("not_requested") @map("crm_status")
  campaign     BlackFridayCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  lead         Lead              @relation(fields: [leadId], references: [id], onDelete: Restrict)
  consultant   Consultant?       @relation(fields: [consultantId], references: [id], onDelete: SetNull)

  @@index([campaignId, supervisorId], map: "idx_black_friday_campaign_supervisor")
  @@index([consultantId], map: "idx_black_friday_consultant")
  @@map("black_friday_leads")
}

model DistributionAudit {
  id              Int      @id @default(autoincrement())
  action          String
  requestedById   String   @map("requested_by_id")
  requestedByName String   @map("requested_by_name")
  requestedByEmail String? @map("requested_by_email")
  requestedByRole String   @map("requested_by_role")
  consultantId    String   @map("consultant_id")
  consultantCrmId String?  @map("consultant_crm_id")
  consultantName  String   @map("consultant_name")
  niche           String
  quantity        Int
  state           String?
  city            String?
  crmRequested    Boolean  @default(false) @map("crm_requested")
  listId          Int?     @map("list_id")
  campaignId      Int?     @map("campaign_id")
  campaignName    String?  @map("campaign_name")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("distribution_audit")
  @@index([requestedById, id], map: "idx_distribution_audit_requester_id")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
