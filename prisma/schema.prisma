generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        Int      @id @default(autoincrement())
  name      String?
  phone     String?  @unique
  nicho     String?
  city      String?
  state     String?
  company   String?
  fantasy   String?
  createdAt DateTime @default(now()) @map("created_at")

  listaLeads ListaLead[]
  blackFridayClaim BlackFridayLead?

  @@map("leads")
  @@index([city], map: "idx_leads_city")
  @@index([nicho], map: "idx_leads_nicho")
  @@index([nicho, state, city], map: "idx_leads_nicho_state_city")
}

model ImportLog {
  id         Int      @id @default(autoincrement())
  fileName   String   @map("file_name")
  totalRows  Int      @map("total_rows")
  validRows  Int      @map("valid_rows")
  invalidRows Int     @map("invalid_rows")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("import_logs")
}

model Lista {
  id          Int      @id @default(autoincrement())
  consultorId Int      @map("consultor_id")
  crmConsultantId String? @map("crm_consultant_id")
  nicho       String
  quantidade  Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  
  agendorStatus String    @default("none") @map("agendor_status")
  agendorSentAt DateTime? @map("agendor_sent_at")

  leads ListaLead[]

  @@map("listas")
  @@index([consultorId], map: "idx_listas_consultor_id")
  @@index([crmConsultantId, createdAt], map: "idx_listas_crm_consultant_created_at")
  @@index([nicho], map: "idx_listas_nicho")
}

model ConsultantQuota {
  crmUserId    String   @id @map("crm_user_id")
  monthlyLimit Int      @default(300) @map("monthly_limit")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("consultant_quotas")
}

model ConsultantMonthlyUsage {
  id         Int      @id @default(autoincrement())
  crmUserId  String   @map("crm_user_id")
  monthStart DateTime @map("month_start") @db.Date
  used       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([crmUserId, monthStart], map: "uq_consultant_monthly_usage_user_month")
  @@index([monthStart], map: "idx_consultant_monthly_usage_month")
  @@map("consultant_monthly_usage")
}

model ListaLead {
  id      Int   @id @default(autoincrement())
  listaId Int   @map("lista_id")
  leadId  Int   @map("lead_id")

  lista Lista @relation(fields: [listaId], references: [id], onDelete: Cascade)
  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lista_leads")
  @@unique([listaId, leadId], map: "uq_lista_leads_lista_id_lead_id")
  @@index([leadId], map: "idx_lista_leads_lead_id")
  @@index([listaId], map: "idx_lista_leads_lista_id")
}

model Consultant {
  id           String   @id @default(uuid())
  crmMemberId  String?  @unique(map: "uq_consultants_crm_member_id") @map("crm_member_id")
  name         String
  supervisorId String   @map("supervisor_id")
  createdAt    DateTime @default(now()) @map("created_at")
  blackFridayLeads BlackFridayLead[]

  @@map("consultants")
  @@index([supervisorId], map: "idx_consultants_supervisor_id")
}

model BlackFridayCampaign {
  id        Int              @id @default(autoincrement())
  year      Int              @unique
  name      String
  nicho     String           @unique
  isActive  Boolean          @default(true) @map("is_active")
  startsAt  DateTime         @map("starts_at") @db.Date
  endsAt    DateTime         @map("ends_at") @db.Date
  createdAt DateTime         @default(now()) @map("created_at")
  leads     BlackFridayLead[]

  @@map("black_friday_campaigns")
}

model BlackFridayLead {
  id           Int               @id @default(autoincrement())
  campaignId   Int               @map("campaign_id")
  leadId       Int               @unique @map("lead_id")
  supervisorId String            @map("supervisor_id")
  consultantId String?           @map("consultant_id")
  consultantName String          @map("consultant_name")
  assignedAt   DateTime          @default(now()) @map("assigned_at")
  crmStatus    String            @default("not_requested") @map("crm_status")
  campaign     BlackFridayCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  lead         Lead              @relation(fields: [leadId], references: [id], onDelete: Restrict)
  consultant   Consultant?       @relation(fields: [consultantId], references: [id], onDelete: SetNull)

  @@index([campaignId, supervisorId], map: "idx_black_friday_campaign_supervisor")
  @@index([consultantId], map: "idx_black_friday_consultant")
  @@map("black_friday_leads")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
